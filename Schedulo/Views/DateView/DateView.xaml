<UserControl x:Class="Schedulo.Views.DateView.DateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Schedulo.Views.DateView"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="640" d:DesignWidth="1008">
    <Border 
            BorderBrush="{StaticResource GrayColor}" 
            BorderThickness="1px" 
            CornerRadius="4">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64px"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border 
                    Grid.Column="0" 
                    BorderBrush="{StaticResource GrayColor}" 
                    BorderThickness="1px">
                    <TextBlock 
                        Text="{Binding Gmt}"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"/>
                </Border>

                <Border 
                    Grid.Column="1" Grid.Row="0"
                    BorderBrush="{StaticResource GrayColor}" 
                    BorderThickness="1px" >
                    <StackPanel Margin="15 0 0 0">
                        <TextBlock 
                                Text="{Binding Date, StringFormat='{}{0:ddd}'}"
                                HorizontalAlignment="Left"/>

                        <TextBlock 
                                Text="{Binding Date, StringFormat='{}{0:dd}'}"
                                Style="{StaticResource TextDay}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <ScrollViewer 
                        Grid.Row="1" 
                        VerticalScrollBarVisibility="Hidden"
                        Height="{Binding ScrollHeight, Mode=OneWay}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="ScrollChanged">
                        <i:InvokeCommandAction Command="{Binding ScrollCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64px"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding HourBlocks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource GrayColor}" BorderThickness="1px" Height="64px">
                                    <TextBlock 
                                            Text="{Binding StringFormat='{}{0:h tt}'}"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding HourBlocks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource GrayColor}" BorderThickness="1px" Height="64px">

                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
