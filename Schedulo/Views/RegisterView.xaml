<Window x:Class="Schedulo.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Schedulo.Views"
        xmlns:resources="clr-namespace:Schedulo.Properties"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Schedulo" Height="540" Width="720">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320px"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="138"/>
                    <RowDefinition Height="166"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0 32 0 0"
                           Text="{x:Static resources:Resources.R01}"
                           Style="{StaticResource HeaderTextStyle}"/>
                <StackPanel Grid.Row="1">
                    <TextBox Text="{x:Static resources:Resources.R02}"
                            Style="{StaticResource InputTextStyle}"
                            Foreground="{StaticResource GrayColor}"/>

                    <TextBox Text="{x:Static resources:Resources.R03}"
                            Style="{StaticResource InputTextStyle}"
                            Foreground="{StaticResource GrayColor}"/>
                    
                    <Button Margin="0 8 0 0"
                            Content="{x:Static resources:Resources.R04}"
                            Style="{StaticResource ButtonSubmitStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Line Grid.Column="0"
                              Style="{StaticResource LineStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="Or" Foreground="{StaticResource LightBlack}"
                                   VerticalAlignment="Center"
                                   Margin="10,0" />
                        <Line Grid.Column="2" 
                              Style="{StaticResource LineStyle}"/>
                    </Grid>
                </StackPanel>
                
                <StackPanel Grid.Row="3" Margin="0 16 0 0">
                    <Button Style="{StaticResource ButtonLinkStyle}" >
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/Schedulo;component/Resources/Google_Logo.png" Width="24" Height="24" Margin="0 0 15 0"/>
                            <TextBlock Text="{x:Static resources:Resources.R05}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonLinkStyle}" >
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/Schedulo;component/Resources/Microsoft_Logo.png" Width="24" Height="24" Margin="0 0 15 0"/>
                            <TextBlock Text="{x:Static resources:Resources.R06}"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Static resources:Resources.R07}" 
                                   FontSize="14px"/>
                        <TextBlock Text="{x:Static resources:Resources.R07_1}" 
                                   Margin="5 0 0 0"
                                   FontSize="14px" 
                                   Foreground="{StaticResource SignUpText}" 
                                   FontStyle="Oblique"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
